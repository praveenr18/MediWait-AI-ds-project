# ==============================================================================
# MediWait AI - Root Git Ignore Configuration
# ==============================================================================

# 1. Environment & Secret Variables (Never commit actual credentials)
.env
.env.*
.env.local
.env.development
.env.test
.env.production
!.env.example

# 2. Node.js & Frontend Build Outputs
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
dist/
dist-ssr/
build/
out/

# 3. Python Virtual Environments & Packages
venv/
.venv/
env/
ENV/
env.bak/
venv.bak/
*.egg-info/
*.egg
eggs/
parts/
bin/
var/
sdist/
develop-eggs/
.installed.cfg
lib/
lib64/

# 4. Python Bytecode & Cache Directories
__pycache__/
*.py[cod]
*$py.class
*.pyc
*.pyo
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/
.tox/
.nox/

# 5. Databases & Local Persistent Storage
*.db
*.sqlite
*.sqlite3
*.db-journal
*.db-wal
*.db-shm

# 6. IDEs, Editors & Tooling Cache
.vscode/
!.vscode/settings.json
!.vscode/extensions.json
.idea/
*.sublime-project
*.sublime-workspace
*.swp
*.swo
*~

# 7. Operating System Artifacts & Temporary Files
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
[Dd]esktop.ini
*.tmp
*.temp
*.bak

# 8. Unnecessary Log Files
*.log
logs/