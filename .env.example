# ==============================================================================
# MediWait AI - Environment Configuration Example
# Copy this file to .env in backend/ or frontend/ for local configuration
# ==============================================================================

# ------------------------------------------------------------------------------
# Backend Configuration (FastAPI)
# ------------------------------------------------------------------------------
# Database URL (SQLite default or PostgreSQL connection string)
DATABASE_URL=sqlite:///./mediwait.db
# Example for PostgreSQL:
# DATABASE_URL=postgresql://user:password@localhost:5432/mediwait

# JWT Security
# Replace with a cryptographically secure random string in production
JWT_SECRET=your_jwt_secret_key_change_in_production

# Server Host & Port
HOST=0.0.0.0
PORT=8000

# ------------------------------------------------------------------------------
# Frontend Configuration (React / Vite)
# ------------------------------------------------------------------------------
VITE_API_BASE=http://localhost:8000/api
